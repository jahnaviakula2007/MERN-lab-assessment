<!DOCTYPE html>
<html>
<head>
    <title>Form Validation</title>
</head>
<body>

    <h1>User Registration Form</h1>

    <% if (error) { %>
        <p style="color: red;"><%= error %></p>
    <% } %>

    <% if (success) { %>
        <p style="color: green;"><%= success %></p>
    <% } %>

    <form action="/submit" method="POST">

        <label>Name:</label>
        <input 
            type="text" 
            name="name" 
            value="<%= data.name || '' %>"
        >
        <br><br>

        <label>Email:</label>
        <input 
            type="text" 
            name="email" 
            value="<%= data.email || '' %>"
        >
        <br><br>

        <label>Age:</label>
        <input 
            type="number" 
            name="age" 
            value="<%= data.age || '' %>"
        >
        <br><br>

        <button type="submit">Submit</button>

    </form>

</body>
</html>